SESSION_SECRET=replace_with_a_long_random_value
ADMIN_USERNAME=
ADMIN_PASSWORD=
APP_MODE=local
HOST=127.0.0.1
PORT=5173
LOCAL_BACKEND_PORT=5173
ARGENTUM_LOCAL_PORT=5173
ARGENTUM_DATA_DIR=
ARGENTUM_LOCAL_DATA_DIR=

# AI provider stays server-side. Leave Local Demo on until billing/credits are ready.
AI_PROVIDER=local_demo
AI_MODE=demo
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-nano
AI_MONTHLY_LIMIT_USD=10
# Caption intelligence quality gates. Defaults shown.
CAPTION_AUTO_APPROVE_SCORE=85
CAPTION_MINIMUM_SCORE=75
CAPTION_MINIMUM_ACCURACY=90
CAPTION_MINIMUM_TRANSCRIPT_CONFIDENCE=0.72
CAPTION_MAXIMUM_ATTEMPTS=2

# Agent 101 Studio server-side business builder. Never expose these to frontend code.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AGENT101_OUTPUT_DIR=
BRAVE_API_KEY=
SERP_API_KEY=
DALLE_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=
CAPCUT_HANDOFF_URL=https://www.capcut.com/editor
CAPCUT_DOWNLOAD_DIR=./capcut-downloads
CAPCUT_AGENT_DRY_RUN=false
CAPCUT_BRAND_STICKER=Essentrx
# Native CapCut desktop automation requires /Applications/CapCut.app.
# First run: grant Accessibility permission to Terminal/Node in
# System Settings > Privacy & Security > Accessibility.

# Stream provider APIs stay server-side. For the packaged Mac app, you can
# place these in ~/Library/Application Support/Argentum OS/.env or save them
# through Settings -> API Keys.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_APP_ACCESS_TOKEN=
TWITCH_OAUTH_TOKEN=
TWITCH_USER_ACCESS_TOKEN=
TWITCH_ALLOWED_CHANNELS=
TWITCH_EVENTSUB_SECRET=your_random_secret_here_min_10_chars
TWITCH_EVENTSUB_CALLBACK_URL=https://your-public-url.ngrok.io/api/twitch/eventsub
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_OAUTH_TOKEN=

# Clipping Office rolling media intelligence. Segments stay local and are
# bounded by the retention setting; no posting occurs without Human Gate.
STREAMCLIPPER_CAPTURE_ENABLED=true
STREAMCLIPPER_ROLLING_BUFFER_ENABLED=true
STREAMCLIPPER_ROLLING_SEGMENT_SECONDS=4
STREAMCLIPPER_ROLLING_RETENTION_SECONDS=180
STREAMCLIPPER_ROLLING_LOOKBACK_SECONDS=135
STREAMCLIPPER_CONTINUOUS_MEDIA_OBSERVATION=true
STREAMCLIPPER_MEDIA_OBSERVATION_WINDOWS=1
STREAMCLIPPER_MEDIA_OBSERVATION_WARMUP_SECONDS=12
STREAMCLIPPER_CHAT_TRIGGER_KEYWORDS=

# Optional local speech transcription for captured stream buffers.
# Install Whisper CLI separately: pip install openai-whisper
WHISPER_MODEL=base

# Optional. Defaults to ./stocks when that folder is mounted beside Argentum.
STOCK_GURU_PATH=/Volumes/ZYLO/Argentum/stocks
# Optional server-side market-data providers. Stock Guru also accepts the same
# values from ignored stocks/data/provider_keys.json. Never expose keys to the UI.
STOCK_GURU_TWELVE_DATA_API_KEY=
STOCK_GURU_FMP_API_KEY=
STOCK_GURU_ALPHA_VANTAGE_API_KEY=
STOCK_GURU_FRED_API_KEY=
# Optional request-unit budgets. FMP/Stooq/Yahoo units are generally per symbol;
# Twelve Data and yfinance can consume one unit for a batch.
STOCK_GURU_PROVIDER_TWELVE_DATA_DAILY_BUDGET=800
STOCK_GURU_PROVIDER_FMP_DAILY_BUDGET=1000
STOCK_GURU_PROVIDER_ALPHA_VANTAGE_DAILY_BUDGET=25
STOCK_GURU_PROVIDER_YAHOO_CHART_DAILY_BUDGET=10000
STOCK_GURU_PROVIDER_YFINANCE_DAILY_BUDGET=500
STOCK_GURU_PROVIDER_STOOQ_DAILY_BUDGET=1000
STOCK_GURU_PROVIDER_FRED_DAILY_BUDGET=20
# Optional per-market-session caps use the same provider name plus
# PRE_MARKET, REGULAR, AFTER_HOURS, OVERNIGHT, or WEEKEND_HOLIDAY.
# If omitted, the provider's daily budget is also the session cap.
# STOCK_GURU_PROVIDER_YAHOO_CHART_REGULAR_BUDGET=3000
# STOCK_GURU_PROVIDER_FRED_OVERNIGHT_BUDGET=10
STOCK_GURU_PROVIDER_VALIDATION_DAILY_SYMBOLS=12
STOCK_GURU_PROVIDER_VALIDATION_PER_BATCH=3
# Required only for the opt-in official SEC Form 4 importer. Include an app or
# organization name and a monitored contact email, per SEC fair-access guidance.
# The same identity is used by the official Form 13F research importer.
STOCK_GURU_SEC_USER_AGENT=

# Stock Intelligence Command Center. PAPER is the safe default: it permits
# research, proposals, and Human Gate review but never calls broker placement.
# Change to live only for a deliberately supervised production rollout.
STOCK_GURU_EXECUTION_MODE=paper
STOCK_GURU_APPROVAL_TTL_MINUTES=15

# Continuous research cadence while Argentum is running. Market closure changes
# the research mode; it does not stop the scheduler.
STOCK_GURU_AUTO_REFRESH_ACTIVE_MINUTES=3
STOCK_GURU_SCAN_MAX_SYMBOLS=120
STOCK_GURU_SCAN_ROTATE_COUNT=60
# Re-evaluate current BUY/SELL candidates and live broker readiness between full data scans.
STOCK_GURU_READINESS_INTERVAL_MS=1000
STOCK_GURU_AUTO_REFRESH_PREMARKET_MINUTES=5
STOCK_GURU_AUTO_REFRESH_AFTER_HOURS_MINUTES=15
STOCK_GURU_AUTO_REFRESH_OVERNIGHT_MINUTES=30
STOCK_GURU_AUTO_REFRESH_WEEKEND_MINUTES=240
STOCK_GURU_AUTO_FORM4_MINUTES=60
STOCK_GURU_AUTO_13F_MINUTES=1440
STOCK_GURU_AUTO_NEWS_MINUTES=30
STOCK_GURU_AUTO_REFRESH_STARTUP_DELAY_MS=10000
# STOCK_GURU_AUTO_REFRESH_DISABLED=1

# Independent quant-computation daemon. LIVE is intentionally ignored by this
# daemon; exact broker orders still require the existing Human Gate path.
STOCK_GURU_OPERATING_MODE=OBSERVE

# Autonomous local strategy stress lab. One persisted research snapshot feeds
# bounded CPU-only configurations and modeled paths; these are not broker calls
# or historical backtests. Defaults: 2s, 64 configs/candidate, 32 paths/config.
STOCK_SIMULATION_INTERVAL_MS=2000
STOCK_SIMULATION_CONFIGURATIONS_PER_CANDIDATE=64
STOCK_SIMULATION_PATHS_PER_CONFIGURATION=32

# Optional Telegram remote control. The webhook route fails closed unless the
# secret, numeric user allowlist, and numeric chat allowlist all match. Store a
# real bot token in Mac Keychain where possible instead of this file.
STOCK_GURU_TELEGRAM_BOT_TOKEN=
STOCK_GURU_TELEGRAM_CHAT_ID=
STOCK_GURU_TELEGRAM_ALLOWED_USER_IDS=
STOCK_GURU_TELEGRAM_ALLOWED_CHAT_IDS=
STOCK_GURU_TELEGRAM_WEBHOOK_SECRET=
STOCK_GURU_TELEGRAM_RATE_LIMIT_PER_MINUTE=20

# Optional server-side OpenClaw runtime. Disabled until a private Gateway is running.
OPENCLAW_ENABLED=false
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_DEFAULT_MODEL=openclaw/default
OPENCLAW_REQUEST_TIMEOUT_MS=120000
