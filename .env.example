SESSION_SECRET=replace_with_a_long_random_value
ADMIN_USERNAME=
ADMIN_PASSWORD=

# AI provider stays server-side. Leave Local Demo on until billing/credits are ready.
AI_PROVIDER=local_demo
AI_MODE=demo
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-nano
AI_MONTHLY_LIMIT_USD=10

# Optional. Defaults to ./stocks when that folder is mounted beside Argentum.
STOCK_GURU_PATH=/Volumes/ZYLO/Argentum/stocks
# Required only for the opt-in official SEC Form 4 importer. Include an app or
# organization name and a monitored contact email, per SEC fair-access guidance.
STOCK_GURU_SEC_USER_AGENT=

# Stock Intelligence Command Center. PAPER is the safe default: it permits
# research, proposals, and Human Gate review but never calls broker placement.
# Change to live only for a deliberately supervised production rollout.
STOCK_GURU_EXECUTION_MODE=paper
STOCK_GURU_APPROVAL_TTL_MINUTES=15

# Continuous research cadence while Argentum is running. Market closure changes
# the research mode; it does not stop the scheduler.
STOCK_GURU_AUTO_REFRESH_ACTIVE_MINUTES=5
STOCK_GURU_AUTO_REFRESH_PREMARKET_MINUTES=10
STOCK_GURU_AUTO_REFRESH_AFTER_HOURS_MINUTES=15
STOCK_GURU_AUTO_REFRESH_OVERNIGHT_MINUTES=60
STOCK_GURU_AUTO_REFRESH_WEEKEND_MINUTES=240
STOCK_GURU_AUTO_FORM4_MINUTES=60
STOCK_GURU_AUTO_13F_MINUTES=1440
STOCK_GURU_AUTO_NEWS_MINUTES=30
STOCK_GURU_AUTO_REFRESH_STARTUP_DELAY_MS=10000
# STOCK_GURU_AUTO_REFRESH_DISABLED=1

# Optional Telegram remote control. The webhook route fails closed unless the
# secret, numeric user allowlist, and numeric chat allowlist all match. Store a
# real bot token in Mac Keychain where possible instead of this file.
STOCK_GURU_TELEGRAM_BOT_TOKEN=
STOCK_GURU_TELEGRAM_CHAT_ID=
STOCK_GURU_TELEGRAM_ALLOWED_USER_IDS=
STOCK_GURU_TELEGRAM_ALLOWED_CHAT_IDS=
STOCK_GURU_TELEGRAM_WEBHOOK_SECRET=
STOCK_GURU_TELEGRAM_RATE_LIMIT_PER_MINUTE=20
