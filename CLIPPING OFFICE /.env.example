OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TRANSCRIPTION_PROVIDER=auto
TRANSCRIPTION_MODEL=gpt-4o-transcribe
TRANSCRIPTION_TIMESTAMP_MODEL=whisper-1
TRANSCRIPTION_LANGUAGE=
# Optional context that helps preserve streamer names, games, and slang.
TRANSCRIPTION_PROMPT=
CAPTION_AUTO_APPROVE_SCORE=85
CAPTION_MINIMUM_SCORE=75
CAPTION_MINIMUM_ACCURACY=90
CAPTION_MINIMUM_TRANSCRIPT_CONFIDENCE=0.72
CAPTION_MAXIMUM_ATTEMPTS=2
AI_PROVIDER=openai
AI_MODE=live
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AGENT101_OUTPUT_DIR=./outputs
BRAVE_API_KEY=
SERP_API_KEY=
DALLE_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=
CAPCUT_HANDOFF_URL=https://www.capcut.com/editor
CAPCUT_DOWNLOAD_DIR=./capcut-downloads
CAPCUT_AGENT_DRY_RUN=false
CAPCUT_BRAND_STICKER=Essentrx
# Native CapCut desktop automation requires /Applications/CapCut.app.
# First run: grant Accessibility permission to Terminal/Node in
# System Settings > Privacy & Security > Accessibility.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:4177/auth/twitch/callback
TWITCH_OAUTH_TOKEN=
TWITCH_ALLOWED_CHANNELS=
TWITCH_EVENTSUB_SECRET=your_random_secret_here_min_10_chars
TWITCH_EVENTSUB_CALLBACK_URL=https://your-public-url.ngrok.io/api/twitch/eventsub
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_OAUTH_TOKEN=
# Buffer GraphQL API key. Server-side only; never expose it to browser JavaScript.
BUFFER_API_KEY=
# Optional explicit public HTTPS origin used for Buffer's revocable media link.
# Railway normally derives this from its forwarded request headers.
BUFFER_PUBLIC_ORIGIN=
WHISPER_MODEL=small
# Optional native whisper.cpp override. The desktop app auto-detects Homebrew's
# whisper-cli and models stored under Application Support/Argentum OS/models/whisper.
WHISPER_EXECUTABLE=
WHISPER_MODEL_PATH=
# Keep local transcription from using every CPU core and its scratch memory.
WHISPER_THREADS=4
CLIPPER_UPLOAD_DIR=./uploads
CLIPPER_OUTPUT_DIR=./outputs
# Uploads are buffered by the current local parser, so keep this bounded.
CLIPPER_MAX_UPLOAD_BYTES=134217728
# Rolling live-media memory. Keeps a bounded local buffer so late signals can
# recover the setup and payoff that happened before chat reacted.
STREAMCLIPPER_CAPTURE_ENABLED=true
STREAMCLIPPER_MAX_WATCHED_STREAMERS=1
STREAMCLIPPER_MAX_CONCURRENT_MEDIA_JOBS=1
STREAMCLIPPER_MAX_RECORDING_WINDOWS=60
STREAMCLIPPER_STATE_SAVE_INTERVAL_MS=30000
STREAMCLIPPER_CHAT_EVENT_THROTTLE_MS=10000
STREAMCLIPPER_ROLLING_BUFFER_ENABLED=true
STREAMCLIPPER_ROLLING_SEGMENT_SECONDS=4
STREAMCLIPPER_ROLLING_RETENTION_SECONDS=180
STREAMCLIPPER_ROLLING_LOOKBACK_SECONDS=135
STREAMCLIPPER_CONTINUOUS_MEDIA_OBSERVATION=true
STREAMCLIPPER_MEDIA_OBSERVATION_WINDOWS=1
STREAMCLIPPER_MEDIA_OBSERVATION_WARMUP_SECONDS=12
# Optional comma-separated additions. Human-interest and emerging-topic cues
# are included automatically, so this list does not need generic hype words.
STREAMCLIPPER_CHAT_TRIGGER_KEYWORDS=
POST_DAILY_LIMIT=20
OPENAI_TEST_BUDGET_USD=10
PORT=4177
