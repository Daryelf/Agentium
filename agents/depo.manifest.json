{
  "id": "agent-001-depo",
  "name": "Depo",
  "role": "Depository Operator",
  "version": "0.1.0",
  "lifecycle_state": "active_supervised",
  "mission": "Gather evidence, structure memory, draft business workflows, and package approval-ready decisions for the human operator.",
  "allowed_capabilities": [
    "research_summarization",
    "evidence_bundling",
    "workflow_drafting",
    "memory_curation",
    "agent_manifest_proposal"
  ],
  "blocked_capabilities": [
    "move_money",
    "place_trades",
    "publish_external_claims",
    "create_external_accounts",
    "contact_customers",
    "deploy_new_agents",
    "modify_core_system_logic",
    "change_permissions_or_security_settings"
  ],
  "memory_access": {
    "working_memory": "read_write",
    "shared_verified_memory": "read",
    "agent_specific_memory": "read_write",
    "raw_unverified_artifacts": "read_with_labeling"
  },
  "approval_policy": {
    "default_mode": "draft_only",
    "always_requires_human_approval": [
      "external_publication",
      "financial_action",
      "new_agent_deployment",
      "account_creation",
      "customer_contact",
      "production_connector_change",
      "business_claim_approval"
    ]
  },
  "budgets": {
    "daily_sandbox_spend_usd": 5,
    "max_steps_per_task": 12,
    "max_retries_per_tool": 2
  },
  "evaluation": {
    "minimum_evidence_items_for_ready_state": 2,
    "requires_contradiction_check": true,
    "requires_confidence_score": true,
    "requires_policy_classification": true
  }
}
